# Overrides for the local ODTÜ (b) stack; up.sh appends these to a copy of .env to make .env.odtu.
# No secrets here: everything secret still comes from your own .env.
APP_EDITION=ODTU
# Sign in with the persona picker at http://localhost:3100/login/odtu/dev (local only).
INSTITUTION_LOGIN_DEV_STUB=true
OTG_LOGIN_ENABLED=false
# (b) never writes to AWS S3: files go to the compose MinIO (profile minio, started by up.sh). The keys are the local
# throwaway ones from compose.yml. Presigned links point at the host port, which a browser on this machine can reach.
AWS_S3_BUCKET=menton-odtu
AWS_S3_ENDPOINT=http://minio:9000
# The host port of the compose MinIO (MINIO_PORT, 9000 by default); change both together.
AWS_S3_PUBLIC_ENDPOINT=http://localhost:9000
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=menton-local
AWS_S3_SECRET_ACCESS_KEY=menton-local-secret
# No AWS keys from your .env reach the ODTÜ stack (SES included).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# No meeting bot in (b) until Lane V's setup is approved (T11).
MEETING_TRANSCRIPT_BOT_ENABLED=false
MEETING_PROVIDER_BASE_URL=
MEETING_PROVIDER_API_KEY=
MATCHING_PGVECTOR_ENABLED=false
REALTIME_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
DOCUMENTS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# No ODTÜ data goes to an AI provider: the ODTU edition keeps every AI feature off and refuses to start if one is
# switched on, so these override any "true" a local .env still carries.
AI_PROFILE_PARSING_ENABLED=false
AI_SYLLABUS_ENABLED=false
AI_MATCHING_ENABLED=false
AI_MEETING_REPORT_ENABLED=false
AI_TASK_HANDOVER_ENABLED=false
